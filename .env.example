ONTO_LLM_PROVIDER=disabled
ONTO_LLM_MODEL=gpt-4.1-mini
ONTO_LLM_API_KEY=
ONTO_LLM_BASE_URL=https://api.openai.com/v1
ONTO_LLM_CONFIG_PATH=
ONTO_LLM_REASONING_EFFORT=none
ONTO_AZURE_OPENAI_ENDPOINT=
ONTO_AZURE_OPENAI_DEPLOYMENT=
ONTO_AZURE_OPENAI_API_VERSION=2024-10-21

# Tambien se puede referenciar un .env externo con LLM_PROVIDER, LLM_MODEL y
# LLM_API_KEY (por ejemplo, un proveedor compartido). ONTO no copia esa clave.
# La configuracion ONTO_LLM_* local tiene prioridad sobre la compartida.

# Alias Azure soportados tambien:
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_ID=

# Conector Fabric de solo lectura. Puede apuntar a un .env externo que ya tenga
# FABRIC_AUTH_MODE, FABRIC_TENANT_ID, FABRIC_CLIENT_ID y el endpoint Warehouse.
# Si se omite, ONTO reutiliza ONTO_LLM_CONFIG_PATH cuando éste apunta al entorno compartido.
ONTO_FABRIC_CONFIG_PATH=
ONTO_FABRIC_AUTH_RECORD_PATH=

{
  "name": "Ventas Comercial",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "es-AR",
    "tables": [
      {
        "name": "DimCustomer",
        "columns": [
          {"name": "CustomerKey", "dataType": "int64"},
          {"name": "CustomerName", "dataType": "string"},
          {"name": "Zone", "dataType": "string"}
        ]
      },
      {
        "name": "DimProduct",
        "columns": [
          {"name": "ProductKey", "dataType": "int64"},
          {"name": "ProductName", "dataType": "string"},
          {"name": "Category", "dataType": "string"}
        ]
      },
      {
        "name": "DimDate",
        "columns": [
          {"name": "Date", "dataType": "dateTime"},
          {"name": "Month", "dataType": "string"}
        ]
      },
      {
        "name": "FactSales",
        "columns": [
          {"name": "CustomerKey", "dataType": "int64"},
          {"name": "ProductKey", "dataType": "int64"},
          {"name": "Date", "dataType": "dateTime"},
          {"name": "NetSales", "dataType": "decimal"},
          {"name": "GrossMargin", "dataType": "decimal"}
        ],
        "measures": [
          {"name": "Ventas Netas", "expression": "SUM(FactSales[NetSales])"},
          {"name": "Margen %", "expression": "DIVIDE(SUM(FactSales[GrossMargin]), SUM(FactSales[NetSales]))"}
        ]
      }
    ],
    "relationships": [
      {"fromTable": "FactSales", "fromColumn": "CustomerKey", "toTable": "DimCustomer", "toColumn": "CustomerKey"},
      {"fromTable": "FactSales", "fromColumn": "ProductKey", "toTable": "DimProduct", "toColumn": "ProductKey"},
      {"fromTable": "FactSales", "fromColumn": "Date", "toTable": "DimDate", "toColumn": "Date"}
    ]
  }
}
